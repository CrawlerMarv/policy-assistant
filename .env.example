# Which LLM to use: gemini (free tier, Google AI Studio) or anthropic
LLM_PROVIDER=gemini

# Only the key for the chosen provider is needed
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the model (defaults: gemini-3.5-flash-lite / claude-haiku-4-5-20251001)
# LLM_MODEL=
# RAG_TOP_K=3

# Slack bot (python slack_bot.py)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
